# /etc/judge/backend.env  (chmod 640 root:judge)
# DATABASE_URL is filled in by: sudo ./deploy/setup-postgres.sh (generates the password)
DATABASE_URL=postgresql+psycopg://judge:CHANGE_ME@127.0.0.1:5432/judge
JUDGE_BLOB_DIR=/var/lib/judge/blobs
# Optional: protects /internal/metrics and /internal/status
# JUDGE_METRICS_TOKEN=
# Queue tuning (defaults shown)
# JUDGE_HEARTBEAT_TIMEOUT_S=30
# JUDGE_MAX_ATTEMPTS=3
# JUDGE_MAX_JUDGING_S=1800
# JUDGE_FAIR_WINDOW_S=300
