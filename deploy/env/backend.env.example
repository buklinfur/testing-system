# /etc/judge/backend.env  (chmod 640 root:judge)
# DATABASE_URL is filled in by: sudo ./deploy/setup-postgres.sh (generates the password)
DATABASE_URL=postgresql+psycopg://judge:CHANGE_ME@127.0.0.1:5432/judge
JUDGE_BLOB_DIR=/var/lib/judge/blobs
# Optional: protects /internal/metrics and /internal/status
# JUDGE_METRICS_TOKEN=
# Queue tuning (defaults shown)
# JUDGE_HEARTBEAT_TIMEOUT_S=30
# JUDGE_MAX_ATTEMPTS=3
# JUDGE_MAX_JUDGING_S=1800
# JUDGE_FAIR_WINDOW_S=300
# Checks of problem versions (4a.4): taken only when no submission waits; at most this many at once; time limit
# JUDGE_MAX_CONCURRENT_CHECKS=1
# JUDGE_CHECK_TIMEOUT_SEC=600
# Accounts and 2FA (docs/AUTH.md). REQUIRED for admin 2FA: a Fernet key. Put it here without showing it on the
# screen with the command in docs/DEPLOY_WSL2.md, section 2 (it keeps the owner and mode of this file).
# Losing or changing it makes enrolled TOTP secrets unreadable (then: judgectl admin reset-2fa).
JUDGE_SECRET_KEY=CHANGE_ME
# Public app (python -m app.public_main): it refuses to start while JUDGE_SECRET_KEY is the placeholder above,
# without JUDGE_PUBLIC_ORIGIN, or if the two ports are equal. The origin is exactly what browsers send in Origin.
JUDGE_PUBLIC_ORIGIN=https://CHANGE_ME.ru
# JUDGE_PUBLIC_PORT=8000
# JUDGE_INTERNAL_PORT=8001   # must match --port of judge-api-internal.service
# Brute-force limits (defaults shown): per login, stricter for admins; per IP generous (a class shares one IP)
# JUDGE_LOGIN_FAIL_LIMIT=10
# JUDGE_ADMIN_LOGIN_FAIL_LIMIT=5
# JUDGE_LOGIN_WINDOW_S=900
# JUDGE_LOGIN_LOCKOUT_S=900
# JUDGE_IP_FAIL_LIMIT=300
# JUDGE_IP_WINDOW_S=900
# JUDGE_IP_LOCKOUT_S=900
# JUDGE_AUTH_RETENTION_DAYS=30
# JUDGE_TOTP_ISSUER=judge
# Time zone of judgectl tables and of contest.yaml times without an offset (the API always answers in UTC)
# JUDGE_TIMEZONE=UTC
# Problem package limits (defaults shown; docs/PROBLEM_IMPORT.md)
# JUDGE_IMPORT_MAX_ARCHIVE_MB=100
# JUDGE_IMPORT_MAX_UNPACKED_MB=512
# JUDGE_IMPORT_MAX_FILES=5000
# JUDGE_IMPORT_MAX_RATIO=0      # 0: no ratio check (the unpacked limit protects)
# Manual assignments (docs/CLASSROOM.md): the largest text answer, in KB of UTF-8 (default shown)
# JUDGE_ASSIGNMENT_TEXT_MAX_KB=64
# Comments of the class feed (docs/CLASSROOM.md §9): comments of one student per minute, deleted ones counted;
# 0 = no limit (default shown). Teachers have no limit.
# JUDGE_COMMENT_RATE_PER_MIN=10
# Files and links of the class feed (docs/CLASSROOM.md §10; defaults shown). A hand-in: files and links together
# (the text answer apart), one file, all its files; the student's quota counts each distinct file once over all
# their hand-ins (0 = no quota). A teacher's attachments of one item: how many, one file. Caddy's body limit
# (module 6) must be at least the larger of the two file limits.
# JUDGE_SUBMISSION_FILES_MAX=10
# JUDGE_SUBMISSION_FILE_MAX_MB=20
# JUDGE_SUBMISSION_TOTAL_MAX_MB=50
# JUDGE_STUDENT_QUOTA_MB=200
# JUDGE_ITEM_ATTACHMENTS_MAX=20
# JUDGE_ATTACHMENT_MAX_MB=50
# Submissions of students (docs/STUDENT_API.md; defaults shown). The server refuses larger ones before storing
# anything; at most what the runner takes (256 KB a file, 1024 KB an archive), or the app refuses to start. An
# archive is also limited by max_archive_kb of the problem.
# JUDGE_SOURCE_MAX_KB=256
# JUDGE_ARCHIVE_MAX_KB=1024
# Submissions of one student per minute, all contests together (0 = no limit); a contest's submit_cooldown_sec is
# per problem on top of it.
# JUDGE_SUBMIT_RATE_PER_MIN=6
# Attempts of one student to enter a contest (with or without a code) per 10 minutes: codes cannot be guessed.
# JUDGE_ENTER_RATE=10
