[Unit]
Description=Judge internal API for workers (127.0.0.1 only, never behind the reverse proxy)
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=judge
Group=judge
WorkingDirectory=/opt/judge
Environment=PYTHONPATH=/opt/judge:/opt/judge/backend
EnvironmentFile=/etc/judge/backend.env
# --timeout-keep-alive: workers reuse one connection for the heartbeat every 5 s; uvicorn's default (5 s) closed it
# just as the next heartbeat was sent ("Remote end closed connection without response"). Keep it well above.
ExecStart=/opt/judge/.venv/bin/uvicorn app.internal_main:app --host 127.0.0.1 --port 8001 --workers 2 --timeout-keep-alive 75
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/judge

[Install]
WantedBy=multi-user.target
