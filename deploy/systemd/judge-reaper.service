[Unit]
Description=Judge reaper: returns jobs of lost workers to the queue
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=judge
Group=judge
WorkingDirectory=/opt/judge
Environment=PYTHONPATH=/opt/judge:/opt/judge/backend
EnvironmentFile=/etc/judge/backend.env
ExecStart=/opt/judge/.venv/bin/python -m app.maintenance
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# stale uploads (4b.2, D-100): the reaper removes files only in <JUDGE_BLOB_DIR>/tmp (JUDGE_BLOB_DIR of
# backend.env.example); it never touches the blobs, and writes nowhere else. install-wsl.sh creates the directory.
ReadWritePaths=/var/lib/judge/blobs/tmp

[Install]
WantedBy=multi-user.target
