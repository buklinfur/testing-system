[Unit]
Description=Judge reaper: returns jobs of lost workers to the queue
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=judge
Group=judge
WorkingDirectory=/opt/judge
Environment=PYTHONPATH=/opt/judge:/opt/judge/backend
EnvironmentFile=/etc/judge/backend.env
ExecStart=/opt/judge/.venv/bin/python -m app.maintenance
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
